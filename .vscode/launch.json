{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug QuantumOS (gdb + QEMU)",
      "type": "cppdbg",
      "request": "launch",
      "program": "${workspaceFolder}/build/quantum.elf",
      "cwd": "${workspaceFolder}",
      "MIMode": "gdb",
      "miDebuggerServerAddress": "localhost:1234",
      "stopAtEntry": true,
      "setupCommands": [ { "text": "set architecture i386" } ]
    }
  ]
}
